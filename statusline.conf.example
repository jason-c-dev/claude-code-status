# Example ~/.claude/statusline.conf
#
# Every line below is commented out and shows the DEFAULT value. Copy this file to
# ~/.claude/statusline.conf and uncomment only the keys you want to change — a conf
# that restates the defaults silently pins them, so you'd stop picking up upstream
# changes. This file is plain bash, sourced by statusline-command.sh.
#
# Don't edit statusline-command.sh directly: a `git pull` would clobber your
# preferences. That's the whole point of this file.

# --- which segments, in display order ---
# Available: host path model git context cost duration lines limit weather
# host, duration, lines, limit and weather are off by default.
#SEGMENTS="path model git context cost"

# --- separator ---
#SEPARATOR=" | "
#SEP_COLOR="$DIM"

# --- host (off by default; add `host` to SEGMENTS) ---
#HOST_STYLE="short"        # short (up to the first dot) | full (FQDN)
#HOST_LABEL=""             # replace the hostname with your own text

# --- path ---
#PATH_STYLE="tilde"        # tilde | full | basename

# --- model ---
#MODEL_SHOW_WINDOW=1       # append (1M) / (200K)

# --- git ---
#GIT_SHOW_DIRTY=1          # the ✚n uncommitted count
#GIT_SHOW_AHEAD_BEHIND=1   # the ↑n / ↓n upstream counts

# --- context bar ---
#BAR_WIDTH=10
#BAR_WARN=30               # % where the bar turns yellow
#BAR_CRIT=60               # % where it turns red
#BAR_FILLED="█"
#BAR_EMPTY="░"
#CONTEXT_SHOW_TOKENS=1     # the "· 620.2K tok" suffix

# --- weather (the ONLY segment that uses the network; off by default) ---
# Needs `weather` in SEGMENTS *and* an airport code. Fetched in the background
# and cached, so rendering never blocks. Sends the code to wttr.in every TTL.
# Airport codes only: exactly 3 letters, case-insensitive. Anything else — a city
# name, a 4-letter ICAO code — is rejected and the segment stays off.
#WEATHER_AIRPORT=""         # "SFO" / "LHR" / "SYD"
#WEATHER_UNITS="C"          # C | F
#WEATHER_TTL=900            # seconds between refreshes
#WEATHER_PROVIDER="wttr"    # wttr | open-meteo (open-meteo needs LAT/LON; the code is just the label)
#WEATHER_LAT=""             # e.g. 37.6213
#WEATHER_LON=""             # e.g. -122.3790

# --- icons (keep the trailing space; set "" to drop an icon) ---
#ICON_HOST="🖥️ "
#ICON_PATH="📁 "
#ICON_GIT="🌿 "
#ICON_COST="💰 "
#ICON_DURATION="⏱️ "
#ICON_LINES="±"
#ICON_LIMIT="⏳ "
#ICON_WEATHER="✈️ "

# --- colors ---
# Available: $CYAN $MAGENTA $GREEN $YELLOW $BLUE $RED $WHITE $DIM
# For anything else use a raw escape, noting the $'...' quoting:
#   COLOR_PATH=$'\033[38;5;208m'
#COLOR_HOST="$BLUE"
#COLOR_PATH="$CYAN"
#COLOR_MODEL="$MAGENTA"
#COLOR_GIT="$GREEN"
#COLOR_DIRTY="$YELLOW"
#COLOR_SYNC="$BLUE"
#COLOR_COST="$YELLOW"
#COLOR_DURATION="$WHITE"
#COLOR_LINES="$WHITE"
#COLOR_LIMIT="$WHITE"
#COLOR_WEATHER="$CYAN"

# --- a few worked examples ---
# Several machines, know which one you're on:
#SEGMENTS="host path model git context cost"
#
# Minimal, no icons:
#SEGMENTS="model context"
#ICON_PATH=""
#
# Everything on, cost-focused ordering:
#SEGMENTS="path git context cost duration lines"
#
# Wide bar, no token count, ASCII only (for terminals without emoji):
#BAR_WIDTH=20
#CONTEXT_SHOW_TOKENS=0
#BAR_FILLED="#"
#BAR_EMPTY="-"
#ICON_PATH=""; ICON_GIT="git:"; ICON_COST="$"
